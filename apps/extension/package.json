  },
  "dependencies": {
    "@inscrib3/core": "workspace:*",
    "@inscrib3/ui": "workspace:*",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.8.0",
    "vue-tsc": "^3.3.7",
    "wxt": "^0.20.27"
  }
}
